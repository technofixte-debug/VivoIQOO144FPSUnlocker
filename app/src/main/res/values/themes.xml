<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.VivoIQOO144FPSUnlocker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основные цвета бренда -->
        <item name="colorPrimary">#34D399</item>
        <item name="colorPrimaryVariant">#111827</item>
        <item name="colorOnPrimary">#111827</item>
        <!-- Вторичные цвета бренда -->
        <item name="colorSecondary">#34D399</item>
        <item name="colorSecondaryVariant">#34D399</item>
        <item name="colorOnSecondary">#111827</item>
        <!-- Цвет строки состояния -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Dialog theme to ensure dark background and correct text colors -->
        <item name="alertDialogTheme">@style/CustomAlertDialog</item>
    </style>

    <style name="CustomAlertDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:background">#1F2937</item>
        <item name="android:textColor">#F9FAFB</item>
        <item name="android:textColorPrimary">#F9FAFB</item>
        <item name="colorAccent">#34D399</item>
    </style>
</resources>